# Copy to .env and fill in. Never commit the real .env file.

# OpenRouter — the single AI provider behind app/ai/provider.py.
# Leave OPENROUTER_API_KEY unset to run fully on template/keyword fallback
# (the app works end-to-end either way — see the AI on/off toggle).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
