# Copy to .env and fill in. Never commit the real .env file.

# OpenRouter — the single AI provider behind app/ai/provider.py.
# Leave OPENROUTER_API_KEY unset to run fully on template/keyword fallback
# (the app works end-to-end either way — see the AI on/off toggle).
OPENROUTER_API_KEY=
# Optional, comma-separated, in preference order. FREE variants only (":free" ids or
# openrouter/free) — anything else is dropped by the code. Unset = the built-in free list.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Only needed to manage the Render service from the CLI/API; the app itself never reads it.
RENDER_API_KEY=
